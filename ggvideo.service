[Unit]
Description=ggvideo-experimental (Goodgallery fork with video; not security reviewed)
After=network.target

[Service]
Type=simple
User=ggvideo
Group=ggvideo
WorkingDirectory=/opt/ggvideo
ExecStart=/usr/bin/node /opt/ggvideo/server.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
Restart=on-failure
RestartSec=2
# Settings (PORT, GALLERIES_ROOT, STATE_DIR, ...), one VARIABLE=value per
# line; see "Configuration" in the README. `node server.js login-link` reads
# the same file, so the link it makes matches the service. The leading "-"
# makes the file optional: without it the defaults apply (port 3000, state
# in /var/lib/ggvideo, galleries in /var/lib/ggvideo/galleries).
EnvironmentFile=-/etc/ggvideo.env
# File and folder names are UTF-8. The server runs its vips and ffmpeg tools under C.UTF-8
# itself; this keeps every other child process and log line consistent.
Environment=LANG=C.UTF-8

[Install]
WantedBy=multi-user.target
